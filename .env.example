# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Neon Postgres. Use the pooled host (the hostname contains "-pooler") for the API.
# Keep the direct host for migrations only. Do not commit the real URL.
# channel_binding is optional here; the server strips it before handing the URL to node-postgres.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Pool
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
