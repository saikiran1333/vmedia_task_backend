# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:3000

# Neon Postgres. Use the pooled host (the hostname contains "-pooler") for the API.
# Keep the direct host for migrations only. Do not commit the real URL.
# channel_binding is optional here; the server strips it before handing the URL to node-postgres.
DATABASE_URL=postgresql://USER:PASSWORD@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require

# Pool
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000

# Optional direct Neon host for migrations and seeding. When empty, the API URL is
# rewritten by removing "-pooler" from the hostname.
DATABASE_URL_UNPOOLED=

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
LOGIN_RATE_LIMIT_MAX=30
ENQUIRY_RATE_LIMIT_MAX=60

# Admin JWT. Use at least 32 random characters. Do not commit the real value.
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Used only by npm run admin:create. Leave empty in the repository.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Optional overrides. Defaults point at the sibling docs seed and the web asset folder.
SEED_FILE=
ASSET_ROOT=
